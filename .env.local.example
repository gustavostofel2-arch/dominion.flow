# Copie este arquivo para .env.local e preencha. O .env.local NUNCA vai pro git.

# Supabase → Project Settings → API (ou "API Keys")
NEXT_PUBLIC_SUPABASE_URL=
# "anon public" (chave legada) OU "publishable key" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" (legada) OU "secret key" (sb_secret_...). Só servidor. Nunca exponha.
SUPABASE_SERVICE_ROLE_KEY=

# Chave privada Ed25519 em uma linha, com \n no lugar das quebras.
# Preenchida automaticamente por: npm run keys
# Só servidor. Nunca exponha, nunca commite.
FLOW_PRIVATE_KEY_PEM=

# Opcional: validade do token em segundos (padrão 600 = 10 min)
FLOW_TOKEN_TTL_SECONDS=600

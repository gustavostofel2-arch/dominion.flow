# Copie este arquivo para .env.local e preencha. O .env.local NUNCA vai pro git.

# Supabase → Project Settings → API (ou "API Keys")
NEXT_PUBLIC_SUPABASE_URL=
# "anon public" (chave legada) OU "publishable key" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" (legada) OU "secret key" (sb_secret_...). Só servidor. Nunca exponha.
SUPABASE_SERVICE_ROLE_KEY=

# Chave privada Ed25519 em uma linha, com \n no lugar das quebras.
# Preenchida automaticamente por: npm run keys
# Só servidor. Nunca exponha, nunca commite.
FLOW_PRIVATE_KEY_PEM=

# Opcional: validade do token em segundos (padrão 600 = 10 min)
FLOW_TOKEN_TTL_SECONDS=600

# --- Lastlink (webhook de assinaturas) ---
# Segredo que vai na URL do webhook (?key=...). Gere com: npm run lastlink:secret
LASTLINK_WEBHOOK_SECRET=
# Token mostrado na tela da integração da Lastlink (opcional; usado para conferência)
LASTLINK_TOKEN=
# true = recusa avisos sem o token da Lastlink (só ligue depois de confirmar que ele chega)
LASTLINK_REQUIRE_TOKEN=false
# IDs dos produtos Dominion Flow na Lastlink, separados por vírgula (vazio = aceita todos)
LASTLINK_PRODUCT_IDS=
# Período de cada pagamento em meses (1 = mensal, 12 = anual)
LASTLINK_PERIOD_MONTHS=1
# Dias de acesso depois da data de renovação (a Lastlink libera 5)
LASTLINK_GRACE_DAYS=5
# true = eventos de teste (botão "Testar" da Lastlink) também ativam assinaturas. Use só para testar.
LASTLINK_APPLY_TEST_EVENTS=false
# IDs das ofertas VITALÍCIAS (pagamento único), separados por vírgula. Opcional:
# compras de pagamento único já são reconhecidas sozinhas; isto é uma garantia extra.
LASTLINK_LIFETIME_OFFER_IDS=
# Link do checkout da Lastlink (botão "Assinar agora" do site)
NEXT_PUBLIC_CHECKOUT_URL=
